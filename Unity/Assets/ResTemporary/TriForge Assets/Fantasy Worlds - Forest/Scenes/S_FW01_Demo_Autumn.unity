--- !u!102 &745904064
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 745904062}
  m_Text: "Thank you for purchasing the asset pack!\nHere are some instructions and
    recommended settings for your project\nto achieve the same visuals as in the
    screenshots and video:\n\nIf you're your project uses BIRP or HDRP, import the
    respective conversion pack\nfound in Fantasy Worlds - Forest folder.\n\nIn your
    URP Settings (by default it's URP-HighFidelity in the Settings folder)\n\n1.
    Enable Depth Texture and Opaque Texture \n2. Switch the Grading Mode to High
    Dynamic Range\n\nTo control the wind use the TriForge Foliage Controller.\n\nFor
    best performance, we recommend Deferred render path.\n\nIf you have any questions
    or need support with the assets you can reach out to\nsupport@triforge.eu\nFor
    support requests remember to include your Unity version\nand render pipeline
    to speed up the process."
  m_OffsetZ: 0
  m_CharacterSize: 0.15
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 85
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
  m_Color:
